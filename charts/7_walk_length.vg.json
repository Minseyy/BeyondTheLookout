{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How long people walk",
    "subtitle": "Length of walk on visitors' most recent park visit, 2024/25 (walkers only)"
  },
  "width": "container",
  "height": 240,
  "data": {
    "url": "data/walk_length_by_branch_2024_25.csv",
    "format": { "parse": { "pct": "number" } }
  },
  "transform": [
    {
      "calculate": "indexof(['Under 1 hour','Up to half a day','Up to a full day','Multi-day',\"Can't say\"], datum.length)",
      "as": "order"
    }
  ],
  "encoding": {
    "y": {
      "field": "branch",
      "type": "nominal",
      "sort": ["All NSW parks", "Southern Ranges", "Blue Mountains", "South Coast",
               "Hunter Central Coast", "Greater Sydney", "North Coast"],
      "title": null,
      "axis": {
        "ticks": false,
        "domain": false,
        "labelFontWeight": { "condition": { "test": "datum.value == 'All NSW parks'", "value": "bold" }, "value": "normal" }
      }
    }
  },
  "layer": [
    {
      "mark": { "type": "bar", "height": { "band": 0.65 } },
      "encoding": {
        "x": {
          "field": "pct",
          "type": "quantitative",
          "stack": "zero",
          "title": "% of walkers",
          "scale": { "domain": [0, 100] },
          "axis": { "values": [0, 25, 50, 75, 100], "labelExpr": "datum.value + '%'" }
        },
        "color": {
          "field": "length",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": ["Under 1 hour", "Up to half a day", "Up to a full day", "Multi-day", "Can't say"],
            "range": ["#cfe3c4", "#8fb98a", "#e9c46a", "#e76f51", "#d9d4c7"]
          },
          "legend": { "orient": "top", "direction": "horizontal", "columns": 5 }
        },
        "order": { "field": "order", "type": "quantitative" },
        "tooltip": [
          { "field": "branch", "title": "Region" },
          { "field": "length", "title": "Walk length" },
          { "field": "pct", "title": "% of walkers" }
        ]
      }
    },
    {
      "transform": [
        {
          "window": [{ "op": "sum", "field": "pct", "as": "cum" }],
          "groupby": ["branch"],
          "sort": [{ "field": "order" }],
          "frame": [null, 0]
        },
        { "calculate": "datum.cum - datum.pct / 2", "as": "mid" },
        { "filter": "datum.pct >= 8" }
      ],
      "mark": { "type": "text", "fontSize": 10, "color": "#1f3d17" },
      "encoding": {
        "x": { "field": "mid", "type": "quantitative" },
        "text": { "field": "pct", "type": "quantitative", "format": "d" }
      }
    }
  ],
  "config": { "view": { "stroke": null } }
}