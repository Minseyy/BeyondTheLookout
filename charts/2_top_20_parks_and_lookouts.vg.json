          }
        ]
      },
      "transform": [
        {
          "calculate": "'Lookout (hover for its name)'",
          "as": "kind"
        }
      ]
    },
    {
      "data": {
        "url": "data/2_top_20_parks_and_lookouts/park_circles.json"
      },
      "transform": [
        {
          "filter": "datum.where == 'map' && !datum.in_zoom"
        },
        {
          "calculate": "datum.park == 'Kosciuszko' || datum.park == 'Coffs Coast' ? 'west' : datum.park == 'Glenrock' ? 'south' : datum.park == 'Worimi Conservation Lands' ? 'north' : 'east'",
          "as": "label_pos"
        },
        {
          "filter": "datum.label_pos == 'east'"
        },
        {
          "calculate": "datum.park == 'Worimi Conservation Lands' ? 'Worimi' : datum.park",
          "as": "name"
        }
      ],
      "mark": {
