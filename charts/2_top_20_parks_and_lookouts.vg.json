          "field": "plon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "plat",
          "type": "quantitative"
        },
        "size": {
          "field": "visits",
          "type": "quantitative",
          "title": "Visits to each park, 2024/25",
          "scale": {
            "domain": [
              0,
              8000000
            ],
            "range": [
              40,
              600
            ]
          },
          "legend": {
            "values": [
              1000000,
              4000000,
              8000000
            ],
            "format": "~s",
            "orient": "top",
            "direction": "horizontal",
            "symbolFillColor": "#e76f51",
            "symbolOpacity": 0.9,
            "symbolStrokeColor": "white",
            "symbolStrokeWidth": 1.2,
            "labelExpr": "datum.value / 1000000 + ' million'",
            "titleFontSize": 11,
            "labelFontSize": 11,
            "titleLimit": 240,
            "columnPadding": 14,
            "padding": 0,
            "offset": 4
          }
        },
        "order": {
          "field": "visits",
          "sort": "descending"
        },
        "opacity": {
          "condition": {
            "test": "highlightPark == null || datum.park == highlightPark",
            "value": 0.9
          },
          "value": 0.25
        },
        "stroke": {
          "condition": {
            "test": "highlightPark != null && datum.park == highlightPark",
            "value": "#1f3d17"
          },
          "value": "white"
        },
        "strokeWidth": {
          "condition": {
            "test": "highlightPark != null && datum.park == highlightPark",
            "value": 2.5
          },
          "value": 1.2
        },
