{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Locals come for the park. Interstate visitors come for the trip",
    "subtitle": "How NSW and interstate visitors answered three survey questions about their last park visit, 2024/25 (% of each group)"
  },
  "data": {
    "url": "data/visitor_profile_2024_25.csv",
    "format": {
      "parse": {
        "order": "number",
        "pct": "number"
      }
    }
  },
  "hconcat": [
    {
      "title": {
        "text": "Why they came",
        "anchor": "start",
        "fontSize": 13,
        "font": "Inter, system-ui, sans-serif",
        "fontWeight": 600,
        "color": "#1f3d17"
      },
      "width": 170,
      "height": 260,
      "transform": [
        {
          "filter": "datum.question == 'Why they came'"
        },
        {
          "calculate": "datum.origin == 'NSW visitors' ? 'NSW' : 'Interstate'",
          "as": "who"
        },
        {
          "stack": "pct",
          "groupby": [
            "who"
          ],
          "sort": [
            {
              "field": "order",
              "order": "ascending"
            }
          ],
          "offset": "normalize",
          "as": [
            "y0",
            "y1"
          ]
        },
        {
          "calculate": "(datum.y0 + datum.y1) / 2",
          "as": "ymid"
        },
        {
          "calculate": "datum.answer == 'Main reason for the trip' ? 'white' : '#2b2b2b'",
          "as": "tcol"
        }
      ],
      "encoding": {
        "x": {
          "field": "who",
          "type": "nominal",
          "sort": [
            "NSW",
            "Interstate"
          ],
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 12,
            "ticks": false,
            "domain": false
          },
          "scale": {
            "paddingInner": 0.18,
            "paddingOuter": 0.05
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "stroke": "#f7f2e4",
            "strokeWidth": 1.5
          },
          "encoding": {
            "y": {
              "field": "y0",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  1
                ],
                "reverse": true
              },
              "axis": null
            },
            "y2": {
              "field": "y1"
            },
            "color": {
              "field": "answer",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "Main reason for the trip",
                  "Part of the reason",
                  "Not a reason / can't say"
                ],
                "range": [
                  "#b5462b",
                  "#f4a261",
                  "#e4ddd0"
                ]
              },
              "legend": {
                "orient": "bottom",
                "direction": "vertical",
                "labelLimit": 200,
                "symbolType": "square",
                "labelFontSize": 11
              }
            },
            "tooltip": [
              {
                "field": "origin",
                "title": "Visitors"
              },
              {
                "field": "answer",
                "title": "Answer"
              },
              {
                "field": "pct",
                "title": "% of this group"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.y1 - datum.y0 >= 0.05"
            },
            {
              "calculate": "datum.pct + '%'",
              "as": "t"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontWeight": "bold"
          },
          "encoding": {
            "y": {
              "field": "ymid",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            },
            "color": {
              "field": "tcol",
              "type": "nominal",
              "scale": null
            }
          }
        }
      ],
      "resolve": {
        "scale": {
          "color": "independent"
        }
      }
    },
    {
      "title": {
        "text": "How long they stayed",
        "anchor": "start",
        "fontSize": 13,
        "font": "Inter, system-ui, sans-serif",
        "fontWeight": 600,
        "color": "#1f3d17"
      },
      "width": 170,
      "height": 260,
      "transform": [
        {
          "filter": "datum.question == 'How long they stayed'"
