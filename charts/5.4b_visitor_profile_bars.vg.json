            "NSW",
            "Interstate"
          ],
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 12,
            "ticks": false,
            "domain": false
          },
          "scale": {
            "paddingInner": 0.18,
            "paddingOuter": 0.05
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "stroke": "#f7f2e4",
            "strokeWidth": 1.5
          },
          "encoding": {
            "y": {
              "field": "y0",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  1
                ],
                "reverse": true
              },
              "axis": null
            },
            "y2": {
              "field": "y1"
            },
            "color": {
              "field": "answer",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "Day trip",
                  "Stayed one night or more",
                  "Can't say"
                ],
                "range": [
                  "#2f5e22",
                  "#8fb98a",
                  "#e4ddd0"
                ]
              },
              "legend": {
                "orient": "bottom",
                "direction": "vertical",
                "labelLimit": 200,
                "symbolType": "square",
                "labelFontSize": 11
              }
            },
            "tooltip": [
              {
                "field": "origin",
                "title": "Visitors"
              },
              {
                "field": "answer",
                "title": "Answer"
              },
              {
                "field": "pct",
                "title": "% of this group"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.y1 - datum.y0 >= 0.05"
            },
            {
              "calculate": "datum.pct + '%'",
              "as": "t"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontWeight": "bold"
          },
          "encoding": {
            "y": {
              "field": "ymid",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            },
            "color": {
              "field": "tcol",
              "type": "nominal",
              "scale": null
            }
          }
        }
      ],
      "resolve": {
        "scale": {
          "color": "independent"
        }
      }
    },
    {
