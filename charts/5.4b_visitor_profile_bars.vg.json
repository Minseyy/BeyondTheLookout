          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "stroke": "#f7f2e4",
            "strokeWidth": 1.5
          },
          "encoding": {
            "y": {
              "field": "y0",
              "type": "quantitative",
              "scale": {
                "domain": [
