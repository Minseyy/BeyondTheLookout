              "scale": null
            }
          }
        }
      ],
      "resolve": {
        "scale": {
          "color": "independent"
        }
      }
    }
  ],
  "spacing": 28,
  "resolve": {
    "scale": {
      "color": "independent"
    },
    "legend": {
      "color": "independent"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "concat": {
      "spacing": 28
    }
  }
}