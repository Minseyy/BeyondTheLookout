{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Role of the park in the trip",
    "subtitle": "How much was the park visit the reason for the trip? Each square is 2% of visitors (2024/25)"
  },
  "width": "container",
  "height": 340,
  "data": {
    "url": "data/trip_role_squares.json"
  },
  "encoding": {
    "x": {
      "field": "x",
      "type": "quantitative",
      "title": "The park was... (strongest reason on the left)",
      "scale": {
        "domain": [-1, 17],
        "nice": false,
        "zero": false
      },
      "axis": {
        "values": [0.5, 3.5, 6.5, 9.5, 12.5, 15.5],
        "labelExpr": "[\"Only reason\", \"Main reason\", \"A main reason\", \"Minor reason\", \"Not a reason\", \"Can't say\"][floor(datum.value / 3)]",
        "grid": false,
        "ticks": false,
        "domain": false,
        "labelPadding": 8
      }
    },
    "y": {
      "field": "square",
      "type": "quantitative",
      "title": "% of visitors (each square = 2%)",
      "scale": {
        "domain": [0, 28]
      },
      "axis": {
        "values": [0, 5, 10, 15, 20, 25],
        "labelExpr": "datum.value * 2 + '%'",
        "grid": false
      }
    },
    "color": {
      "field": "visitor",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": ["Local", "Non-local"],
        "range": ["#2a9d8f", "#e76f51"]
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal"
      }
    },
    "tooltip": [
      {
        "field": "role",
        "title": "The park was"
      },
      {
        "field": "visitor",
        "title": "Visitor"
      },
      {
        "field": "pct",
        "title": "% of visitors"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "square",
        "size": 64,
        "opacity": 1
      }
    },
    {
      "transform": [
        {
          "filter": "datum.is_top"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -10,
        "fontSize": 10,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "pctLabel",
          "type": "nominal"
        }
      }
    }
  ]
}
