{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Visits through the year",
    "subtitle": "Visits each month, where 100 is an average month (2024/25)"
  },
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/6.1_visits_through_the_year/monthly_index_2024_25.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 2
      },
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": null,
          "title": null,
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "visit_index",
          "type": "quantitative",
          "title": "Visit index",
          "scale": {
            "domain": [0, 120]
          }
        },
        "color": {
          "value": "#e76f51"
        },
        "tooltip": [
          {
            "field": "month",
            "title": "Month"
          },
          {
            "field": "visit_index",
            "title": "Visit index"
          }
        ]
      }
    },
    {
      "data": {
        "values": [{}]
      },
      "mark": {
        "type": "rule",
        "color": "#1f3d17",
        "strokeWidth": 1.5,
        "strokeDash": [5, 4]
      },
      "encoding": {
        "y": {
          "datum": 100
        }
      }
    },
    {
      "data": {
        "values": [{}]
      },
      "mark": {
        "type": "text",
        "text": "Average month (100)",
        "align": "left",
        "baseline": "bottom",
        "dx": -22,
        "dy": -4,
        "fontSize": 11,
        "color": "#1f3d17"
      },
      "encoding": {
        "x": {
          "datum": "Jul-24"
        },
        "y": {
          "datum": 100
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "month": "Dec-24",
            "at": 116,
            "text": "Summer holidays"
          },
          {
            "month": "Apr-25",
            "at": 108,
            "text": "Easter"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#8a3b24"
      },
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": null,
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelFontWeight": {
              "condition": {
                "test": "indexof(['Aug-24','Dec-24','Jan-25','Apr-25','Jun-25'], datum.value) >= 0",
                "value": "bold"
              },
              "value": "normal"
            },
            "labelColor": {
              "condition": {
                "test": "indexof(['Aug-24','Dec-24','Jan-25','Apr-25','Jun-25'], datum.value) >= 0",
                "value": "#8a3b24"
              },
              "value": "#666"
            }
          }
        },
        "y": {
          "field": "at",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    }
  ]
}
