{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where visitors live",
    "subtitle": "Park visits by home location, 2024/25"
  },
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/visitor_origin_2024_25.csv"
  },
  "transform": [
    {
      "calculate": "indexof(datum.group, 'Intrastate') == 0 ? 'Local' : datum.group == 'Interstate' ? 'Non-local' : datum.group",
      "as": "group"
    }
  ],
  "mark": "bar",
  "encoding": {
    "y": {
      "field": "origin",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },
    "x": {
      "field": "total_visits",
      "type": "quantitative",
      "title": "Visits (2024/25)",
      "axis": {
        "format": "~s",
        "tickCount": 5
      }
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "title": "Visitor from",
      "scale": {
        "domain": [
          "Local",
          "Non-local"
        ],
        "range": [
          "#2a9d8f",
          "#e76f51"
        ]
      }
    },
    "tooltip": [
      {
        "field": "origin",
        "title": "Lives in"
      },
      {
        "field": "group",
        "title": "Visitor"
      },
      {
        "field": "total_visits",
        "title": "Visits",
        "format": ","
      }
    ]
  }
}