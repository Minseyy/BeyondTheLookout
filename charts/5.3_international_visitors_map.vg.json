{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Half of the top international park visitors come from Asia",
    "subtitle": [
      "Top 10 countries of international visitors to NSW national parks, 2024/25. Number in circle = rank.",
      "Circle area = number of visitors; colour = world region. Hover a circle for the exact number."
    ]
  },
  "width": "container",
  "height": 360,
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -150,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/5.3_international_visitors_map/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id != 10"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e9e4d8",
        "stroke": "#f7f2e4",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/5.3_international_visitors_map/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id == 36"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#8fb98a",
        "stroke": "#4f7d45",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/5.3_international_visitors_map/international_visitors_2024_25.csv",
        "format": {
          "parse": {
            "visitors": "number",
            "lon": "number",
            "lat": "number",
            "rank": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.country",
          "as": "label"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "circle",
            "opacity": 0.85,
            "stroke": "white",
            "strokeWidth": 1
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "size": {
              "field": "visitors",
              "type": "quantitative",
              "scale": {
                "range": [
                  0,
                  1000
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "rank",
                "title": "Rank"
              },
              {
                "field": "country",
                "title": "Country"
              },
              {
                "field": "region",
                "title": "Region"
              },
              {
                "field": "visitors",
                "title": "Visitors to NSW parks",
                "format": ","
              }
            ],
            "color": {
              "field": "region",
              "type": "nominal",
              "title": "Share of the top 10's visitors",
              "scale": {
                "domain": [
                  "Asia: 52% (1.03M)",
                  "Europe: 26% (0.52M)",
                  "North America: 15% (0.30M)",
                  "New Zealand: 6% (0.12M)"
                ],
                "range": [
                  "#c4553a",
                  "#2a6f97",
                  "#7a5c99",
                  "#4f7d45"
                ]
              },
              "legend": {
                "orient": "bottom",
                "direction": "horizontal",
                "columns": 2,
                "labelLimit": 0,
                "symbolType": "circle",
                "symbolSize": 120,
                "labelFontSize": 11,
                "titleFontSize": 11
              }
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 10,
            "fontWeight": "bold",
            "color": "white",
            "baseline": "middle"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "rank",
              "type": "quantitative"
            },
            "tooltip": [
              {
                "field": "rank",
                "title": "Rank"
              },
              {
                "field": "country",
                "title": "Country"
              },
              {
                "field": "region",
                "title": "Region"
              },
              {
                "field": "visitors",
                "title": "Visitors to NSW parks",
                "format": ","
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.label_pos == 'east'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 16,
            "dy": 0,
            "baseline": "middle",
            "fontSize": 11,
            "color": "#2b2b2b"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.label_pos == 'west'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -16,
            "dy": 0,
            "baseline": "middle",
            "fontSize": 11,
            "color": "#2b2b2b"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.label_pos == 'north'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "center",
            "dx": 0,
            "dy": -20,
            "baseline": "middle",
            "fontSize": 11,
            "color": "#2b2b2b"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.label_pos == 'south'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "center",
            "dx": 0,
            "dy": 20,
            "baseline": "middle",
            "fontSize": 11,
            "color": "#2b2b2b"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "lon": 147,
            "lat": -32.5,
            "t": "NSW"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#1f3d17",
        "align": "left",
        "dx": 6
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}