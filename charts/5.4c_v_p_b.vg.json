{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Locals come for the park. Interstate visitors come for the trip",
    "subtitle": [
      "How Local (NSW) and Non-Local (Interstate) visitors answered three survey questions about their last park visit, 2024/25.",
      "Bar width is proportional to visits: NSW visitors are 84% of visits, interstate 16%. Segments show % of each group."
    ]
  },
  "data": {
    "url": "data/_shared/visitor_profile_2024_25.csv",
    "format": {
      "parse": {
        "order": "number",
        "pct": "number",
        "origin_visits": "number",
        "x0": "number",
        "x1": "number"
      }
    }
  },
  "hconcat": [
    {
      "title": {
        "text": "Why they came",
        "anchor": "start",
        "fontSize": 13,
        "font": "Inter, system-ui, sans-serif",
        "fontWeight": 600,
        "color": "#1f3d17"
      },
      "width": 230,
      "height": 260,
      "transform": [
        { "filter": "datum.question == 'Why they came'" },
        {
          "stack": "pct",
          "groupby": ["origin"],
          "sort": [{ "field": "order", "order": "ascending" }],
          "offset": "normalize",
          "as": ["y0", "y1"]
        },
        { "calculate": "(datum.y0 + datum.y1) / 2", "as": "ymid" },
        { "calculate": "(datum.x0 + datum.x1) / 2", "as": "xmid" },
        {
          "calculate": "datum.answer == 'Main reason for the trip' ? 'white' : '#2b2b2b'",
          "as": "tcol"
        }
      ],
      "layer": [
        {
          "mark": { "type": "rect", "stroke": "#f7f2e4", "strokeWidth": 1.5 },
          "encoding": {
            "x": {
              "field": "x0",
              "type": "quantitative",
              "scale": { "domain": [0, 1] },
              "axis": {
                "values": [0.41485, 0.92085],
                "labelExpr": "datum.value < 0.5 ? 'NSW' : 'Interstate'",
                "labelAngle": 0,
                "labelFontSize": 12,
                "labelOverlap": false,
                "ticks": false,
                "domain": false,
                "grid": false,
                "title": null
              }
            },
            "x2": { "field": "x1" },
            "y": {
              "field": "y0",
              "type": "quantitative",
              "scale": { "domain": [0, 1], "reverse": true },
              "axis": null
            },
            "y2": { "field": "y1" },
            "color": {
              "field": "answer",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "Main reason for the trip",
                  "Part of the reason",
                  "Not a reason / can't say"
                ],
                "range": ["#b5462b", "#f4a261", "#e4ddd0"]
              },
              "legend": {
                "orient": "bottom",
                "direction": "vertical",
                "labelLimit": 200,
                "symbolType": "square",
                "labelFontSize": 11
              }
            },
            "tooltip": [
              { "field": "origin", "title": "Visitors" },
              { "field": "answer", "title": "Answer" },
              { "field": "pct", "title": "% of this group" }
            ]
          }
        },
        {
          "transform": [
            { "filter": "datum.y1 - datum.y0 >= 0.05" },
            { "calculate": "datum.pct + '%'", "as": "t" }
          ],
          "mark": { "type": "text", "fontSize": 12, "fontWeight": "bold" },
          "encoding": {
            "x": { "field": "xmid", "type": "quantitative" },
            "y": { "field": "ymid", "type": "quantitative" },
            "text": { "field": "t" },
            "color": { "field": "tcol", "type": "nominal", "scale": null }
          }
        }
      ],
      "resolve": { "scale": { "color": "independent" } }
    },
    {
      "title": {
        "text": "How long they stayed",
        "anchor": "start",
        "fontSize": 13,
        "font": "Inter, system-ui, sans-serif",
        "fontWeight": 600,
        "color": "#1f3d17"
      },
      "width": 230,
      "height": 260,
      "transform": [
        { "filter": "datum.question == 'How long they stayed'" },
        {
          "stack": "pct",
          "groupby": ["origin"],
          "sort": [{ "field": "order", "order": "ascending" }],
          "offset": "normalize",
          "as": ["y0", "y1"]
        },
        { "calculate": "(datum.y0 + datum.y1) / 2", "as": "ymid" },
        { "calculate": "(datum.x0 + datum.x1) / 2", "as": "xmid" },
        {
          "calculate": "datum.answer == 'Day trip' ? 'white' : '#2b2b2b'",
          "as": "tcol"
        }
      ],
      "layer": [
        {
          "mark": { "type": "rect", "stroke": "#f7f2e4", "strokeWidth": 1.5 },
          "encoding": {
            "x": {
              "field": "x0",
              "type": "quantitative",
              "scale": { "domain": [0, 1] },
              "axis": {
                "values": [0.41485, 0.92085],
                "labelExpr": "datum.value < 0.5 ? 'NSW' : 'Interstate'",
                "labelAngle": 0,
                "labelFontSize": 12,
                "labelOverlap": false,
                "ticks": false,
                "domain": false,
                "grid": false,
                "title": null
              }
            },
            "x2": { "field": "x1" },
            "y": {
              "field": "y0",
              "type": "quantitative",
              "scale": { "domain": [0, 1], "reverse": true },
              "axis": null
            },
            "y2": { "field": "y1" },
            "color": {
              "field": "answer",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": ["Day trip", "Stayed one night or more", "Can't say"],
                "range": ["#2f5e22", "#8fb98a", "#e4ddd0"]
              },
              "legend": {
                "orient": "bottom",
                "direction": "vertical",
                "labelLimit": 200,
                "symbolType": "square",
                "labelFontSize": 11
              }
            },
            "tooltip": [
              { "field": "origin", "title": "Visitors" },
              { "field": "answer", "title": "Answer" },
              { "field": "pct", "title": "% of this group" }
            ]
          }
        },
        {
          "transform": [
            { "filter": "datum.y1 - datum.y0 >= 0.05" },
            { "calculate": "datum.pct + '%'", "as": "t" }
          ],
          "mark": { "type": "text", "fontSize": 12, "fontWeight": "bold" },
          "encoding": {
            "x": { "field": "xmid", "type": "quantitative" },
            "y": { "field": "ymid", "type": "quantitative" },
            "text": { "field": "t" },
            "color": { "field": "tcol", "type": "nominal", "scale": null }
          }
        }
      ],
      "resolve": { "scale": { "color": "independent" } }
    },
    {
      "title": {
        "text": "How satisfied they were",
        "anchor": "start",
        "fontSize": 13,
        "font": "Inter, system-ui, sans-serif",
        "fontWeight": 600,
        "color": "#1f3d17"
      },
      "width": 230,
      "height": 260,
      "transform": [
        { "filter": "datum.question == 'How satisfied they were'" },
        {
          "stack": "pct",
          "groupby": ["origin"],
          "sort": [{ "field": "order", "order": "ascending" }],
          "offset": "normalize",
          "as": ["y0", "y1"]
        },
        { "calculate": "(datum.y0 + datum.y1) / 2", "as": "ymid" },
        { "calculate": "(datum.x0 + datum.x1) / 2", "as": "xmid" },
        {
          "calculate": "datum.answer == 'Satisfied' ? 'white' : '#2b2b2b'",
          "as": "tcol"
        }
      ],
      "layer": [
        {
          "mark": { "type": "rect", "stroke": "#f7f2e4", "strokeWidth": 1.5 },
          "encoding": {
            "x": {
              "field": "x0",
              "type": "quantitative",
              "scale": { "domain": [0, 1] },
              "axis": {
                "values": [0.41485, 0.92085],
                "labelExpr": "datum.value < 0.5 ? 'NSW' : 'Interstate'",
                "labelAngle": 0,
                "labelFontSize": 12,
                "labelOverlap": false,
                "ticks": false,
                "domain": false,
                "grid": false,
                "title": null
              }
            },
            "x2": { "field": "x1" },
            "y": {
              "field": "y0",
              "type": "quantitative",
              "scale": { "domain": [0, 1], "reverse": true },
              "axis": null
            },
            "y2": { "field": "y1" },
            "color": {
              "field": "answer",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": ["Satisfied", "Neutral or dissatisfied"],
                "range": ["#2a6f97", "#e4ddd0"]
              },
              "legend": {
                "orient": "bottom",
                "direction": "vertical",
                "labelLimit": 200,
                "symbolType": "square",
                "labelFontSize": 11
              }
            },
            "tooltip": [
              { "field": "origin", "title": "Visitors" },
              { "field": "answer", "title": "Answer" },
              { "field": "pct", "title": "% of this group" }
            ]
          }
        },
        {
          "transform": [
            { "filter": "datum.y1 - datum.y0 >= 0.05" },
            { "calculate": "datum.pct + '%'", "as": "t" }
          ],
          "mark": { "type": "text", "fontSize": 12, "fontWeight": "bold" },
          "encoding": {
            "x": { "field": "xmid", "type": "quantitative" },
            "y": { "field": "ymid", "type": "quantitative" },
            "text": { "field": "t" },
            "color": { "field": "tcol", "type": "nominal", "scale": null }
          }
        }
      ],
      "resolve": { "scale": { "color": "independent" } }
    }
  ],
  "spacing": 28,
  "resolve": {
    "scale": { "color": "independent" },
    "legend": { "color": "independent" }
  },
  "config": {
    "view": { "stroke": null },
    "concat": { "spacing": 28 }
  }
}