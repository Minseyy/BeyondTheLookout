{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Visits per lookout by region",
    "subtitle": [
      "2024/25 park visits divided by the number of lookouts: how many visits each lookout has to share.",
      "Hover over a region for details."
    ],
    "font": "Fraunces, Georgia, serif",
    "fontSize": 20,
    "color": "#1f3d17",
    "anchor": "start",
    "subtitleFontSize": 12,
    "subtitleColor": "#444444"
  },
  "width": "container",
  "height": 520,
  "background": "#dceef2",
  "projection": {
    "type": "mercator"
  },
  "view": {
    "fill": "#dceef2",
    "stroke": null
  },
  "layer": [
    {
      "data": {
        "url": "data/_shared/nsw_fixed.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#a8dcef",
        "stroke": null
      }
    },
    {
      "data": {
        "url": "data/_shared/branches_fixed.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "params": [
        {
          "name": "hoverRegion",
          "select": {
            "type": "point",
            "fields": ["branch"],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "transform": [
        {
          "filter": "datum.properties.NAME != 'ACT'"
        },
        {
          "calculate": "datum.properties.NAME",
          "as": "branch"
        },
        {
          "lookup": "branch",
          "from": {
            "data": {
              "url": "data/3_park_visits_per_lookout/region_lookouts.json"
            },
            "key": "branch",
            "fields": ["visits", "lookouts", "perLookout"]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "cursor": "pointer"
      },
      "encoding": {
        "color": {
          "field": "perLookout",
          "type": "quantitative",
          "title": "Park visits per lookout",
          "scale": {
            "type": "threshold",
            "domain": [25000, 50000, 75000, 150000],
            "range": ["#fbf3dc", "#f4dcae", "#eebd8c", "#e0956c", "#a8432a"]
          },
          "legend": {
            "type": "symbol",
            "orient": "top",
            "direction": "horizontal",
            "titleOrient": "top",
            "symbolType": "square",
            "symbolSize": 220,
            "titleFontSize": 12,
            "labelFontSize": 11,
            "columnPadding": 10,
            "format": "~s",
            "padding": 0,
            "offset": 10
          }
        },
        "stroke": {
          "condition": {
            "param": "hoverRegion",
            "empty": false,
            "value": "#e76f51"
          },
          "value": "white"
        },
        "strokeWidth": {
          "condition": {
            "param": "hoverRegion",
            "empty": false,
            "value": 3
          },
          "value": 1.2
        },
        "tooltip": [
          {
            "field": "branch",
            "title": "NPWS region"
          },
          {
            "field": "lookouts",
            "title": "Lookouts"
          },
          {
            "field": "visits",
            "title": "Park visits (2024/25)",
            "format": ","
          },
          {
            "field": "perLookout",
            "title": "Visits per lookout",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/3_park_visits_per_lookout/branch_visits_2024_25.csv"
      },
      "transform": [
        {
          "filter": "datum.branch != 'West' && datum.branch != 'Northern Inland' && datum.branch != 'Southern Ranges' && datum.branch != 'ACT'"
        },
        {
          "lookup": "branch",
          "from": {
            "data": {
              "url": "data/3_park_visits_per_lookout/region_lookouts.json"
            },
            "key": "branch",
            "fields": ["lookouts", "perLookout"]
          }
        },
        {
          "calculate": "datum.branch == 'North Coast' || datum.branch == 'Hunter Central Coast' || datum.branch == 'Blue Mountains' || datum.branch == 'Greater Sydney' ? 155.2 : 146.0",
          "as": "labelLon"
        },
        {
          "calculate": "datum.branch == 'North Coast' ? -29.5 : datum.branch == 'Hunter Central Coast' ? -31.5 : datum.branch == 'Blue Mountains' ? -33.5 : datum.branch == 'Greater Sydney' ? -35.5 : datum.branch == 'Southern Ranges' ? -35.5 : -38.0",
          "as": "labelLat"
        },
        {
          "calculate": "format(datum.perLookout, ',.0f')",
          "as": "valueLabel"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "#53666a",
            "strokeWidth": 1
          },
          "encoding": {
            "longitude": {
              "field": "label_lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "label_lat",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "labelLon"
            },
            "latitude2": {
              "field": "labelLat"
            }
          }
        },
        {
          "mark": {
            "type": "circle",
            "size": 30,
            "fill": "#26352a",
            "stroke": "white",
            "strokeWidth": 1
          },
          "encoding": {
            "longitude": {
              "field": "label_lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "label_lat",
              "type": "quantitative"
            },
            "tooltip": [
              {
                "field": "branch",
                "title": "NPWS region"
              },
              {
                "field": "lookouts",
                "title": "Lookouts"
              },
              {
                "field": "visits",
                "title": "Park visits (2024/25)",
                "format": ","
              },
              {
                "field": "perLookout",
                "title": "Visits per lookout",
                "format": ",.0f"
              }
            ]
          }
        }
      ]
    },
    {
      "data": {
        "url": "data/3_park_visits_per_lookout/branch_visits_2024_25.csv"
      },
      "transform": [
        {
          "filter": "datum.branch != 'West' && datum.branch != 'Northern Inland' && datum.branch != 'Southern Ranges' && datum.branch != 'ACT'"

        },
        {
          "lookup": "branch",
          "from": {
            "data": {
              "url": "data/3_park_visits_per_lookout/region_lookouts.json"
            },
            "key": "branch",
            "fields": ["lookouts", "perLookout"]
          }
        },
        {
          "calculate": "datum.branch == 'North Coast' || datum.branch == 'Hunter Central Coast' || datum.branch == 'Blue Mountains' || datum.branch == 'Greater Sydney' ? 155.2 : 146.0",
          "as": "labelLon"
        },
        {
          "calculate": "datum.branch == 'North Coast' ? -29.5 : datum.branch == 'Hunter Central Coast' ? -31.5 : datum.branch == 'Blue Mountains' ? -33.5 : datum.branch == 'Greater Sydney' ? -35.5 : -38.0",
          "as": "labelLat"
        },
        {
          "calculate": "datum.branch + '\\n' + format(datum.perLookout, ',.0f')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "fontWeight": "bold",
        "baseline": "middle",
        "align": "left",
        "lineBreak": "\n",
        "lineHeight": 13
      },
      "encoding": {
        "longitude": {
          "field": "labelLon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "labelLat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.branch == 'Greater Sydney'",
            "value": "#9b2d1a"
          },
          "value": "#26352a"
        },
        "tooltip": [
          {
            "field": "branch",
            "title": "NPWS region"
          },
          {
            "field": "lookouts",
            "title": "Lookouts"
          },
          {
            "field": "visits",
            "title": "Park visits (2024/25)",
            "format": ","
          },
          {
            "field": "perLookout",
            "title": "Visits per lookout",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/3_park_visits_per_lookout/branch_visits_2024_25.csv"
      },
      "transform": [
        {
          "filter": "datum.branch == 'West' || datum.branch == 'Northern Inland' || datum.branch == 'Southern Ranges'"
        },
        {
          "lookup": "branch",
          "from": {
            "data": {
              "url": "data/3_park_visits_per_lookout/region_lookouts.json"
            },
            "key": "branch",
            "fields": ["lookouts", "perLookout"]
          }
        },
        {
          "calculate": "datum.branch + '\\n' + format(datum.perLookout, ',.0f')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "fontWeight": "bold",
        "color": "#26352a",
        "baseline": "middle",
        "align": "center",
        "lineBreak": "\n",
        "lineHeight": 13
      },
      "encoding": {
        "longitude": {
          "field": "label_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "branch",
            "title": "NPWS region"
          },
          {
            "field": "lookouts",
            "title": "Lookouts"
          },
          {
            "field": "visits",
            "title": "Park visits (2024/25)",
            "format": ","
          },
          {
            "field": "perLookout",
            "title": "Visits per lookout",
            "format": ",.0f"
          }
        ]
      }
    }
  ]
}
