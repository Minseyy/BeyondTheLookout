{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Park track map",
  "width": "container",
  "height": 500,
  "params": [
    {
      "name": "park",
      "value": "Blue Mountains"
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "view": {
    "fill": "#a8dcef",
    "stroke": null
  },
  "layer": [
    {
      "data": {
        "url": "data/4.2_park_track_map/park_map_shapes.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.map_park == park && datum.properties.layer == 'frame'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#a8dcef",
        "stroke": null
      }
    },
    {
      "data": {
        "url": "data/4.2_park_track_map/park_map_shapes.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.map_park == park && datum.properties.layer == 'land'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e3f5ea",
        "stroke": null
      }
    },
    {
      "data": {
        "url": "data/4.2_park_track_map/park_map_shapes.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.map_park == park && datum.properties.layer == 'other_park'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#c0e8cc",
        "stroke": null,
        "opacity": 0.5
      }
    },
    {
      "data": {
        "url": "data/4.2_park_track_map/park_map_shapes.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.map_park == park && datum.properties.layer == 'outline'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#c0e8cc",
        "stroke": "#2f5e22",
        "strokeWidth": 1.2
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.park",
            "title": "Park"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/4.2_park_track_map/park_map_shapes.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.map_park == park && datum.properties.layer == 'track'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeWidth": 3,
        "strokeCap": "round",
        "strokeJoin": "round"
      },
      "encoding": {
        "color": {
          "field": "properties.difficulty",
          "type": "nominal",
          "scale": {
            "domain": [
              "Easy (Class 1–2)",
              "Moderate (Class 3–4)",
              "Hard (Class 5–6)"
            ],
            "range": [
              "#2a9d8f",
              "#e9c46a",
              "#e76f51"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "properties.name",
            "title": "Track"
          },
          {
            "field": "properties.class",
            "title": "Class"
          },
          {
            "field": "properties.length_km",
            "title": "Length (km)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/4.2_park_track_map/park_map_lookouts.json"
      },
      "transform": [
        {
          "filter": "datum.map_park == park"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "triangle-up",
        "size": 70,
        "filled": true,
        "color": "#2f5e22",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Lookout"
          },
          {
            "field": "type",
            "title": "Type"
          }
        ]
      }
    }
  ]
}
