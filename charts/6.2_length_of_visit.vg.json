{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Length of visit",
    "subtitle": "How long visitors stayed on their trip to a park, 2024/25"
  },
  "width": "container",
  "height": 220,
  "data": {
    "url": "data/6.2_length_of_visit/visit_duration_2024_25.csv",
    "format": {
      "parse": {
        "intrastate_pct": "number",
        "interstate_pct": "number"
      }
    }
  },
  "transform": [
    {
      "fold": [
        "intrastate_pct",
        "interstate_pct"
      ],
      "as": [
        "visitor",
        "pct"
      ]
    },
    {
      "calculate": "datum.visitor == 'intrastate_pct' ? 'NSW visitors' : 'Interstate visitors'",
      "as": "visitor"
    },
    {
      "calculate": "indexof([\"Just for the day\", \"Overnight\", \"Multiple nights\", \"Can't say/recall\"], datum.duration)",
      "as": "order"
    }
  ],
  "encoding": {
    "y": {
      "field": "visitor",
      "type": "nominal",
      "sort": [
        "NSW visitors",
        "Interstate visitors"
      ],
      "title": null,
      "axis": {
        "labelFontSize": 12,
        "labelFontWeight": "bold"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.62
        }
      },
      "encoding": {
        "x": {
          "field": "pct",
          "type": "quantitative",
          "stack": "normalize",
          "title": "% of visitors",
          "axis": {
            "format": "%",
            "values": [
              0,
              0.25,
              0.5,
              0.75,
              1
            ]
          },
          "scale": {
            "domain": [
              0,
              1.42
            ]
          }
        },
        "color": {
          "field": "duration",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Just for the day",
              "Overnight",
              "Multiple nights",
              "Can't say/recall"
            ],
            "range": [
              "#cfe3c4",
              "#e9c46a",
              "#e76f51",
              "#d9d4c7"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal"
          }
        },
        "order": {
          "field": "order",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "visitor",
            "title": "Visitor"
          },
          {
            "field": "duration",
            "title": "Stayed"
          },
          {
            "field": "pct",
            "title": "% of visitors"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.duration == 'Overnight' || datum.duration == 'Multiple nights'"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "pct",
              "as": "nights"
            }
          ],
          "groupby": [
            "visitor"
          ]
        },
        {
          "calculate": "datum.nights + '% stay at least one night'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#8a3b24"
      },
      "encoding": {
        "x": {
          "datum": 1,
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}