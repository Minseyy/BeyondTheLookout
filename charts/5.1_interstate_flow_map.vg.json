{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where interstate park visitors come from",
    "subtitle": [
      "Arrows on each curve point into NSW, thicker means more visits to NSW national parks, 2024/25.",
      "Interstate visitors made 10.8 million visits; NSW residents made the other 54.8 million."
    ]
  },
  "width": "container",
  "height": 460,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#dbd6ca",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.properties.is_nsw",
            "value": "#cfe3c4"
          },
          "value": "#e9e4d8"
        },
        "tooltip": [
          {
            "field": "properties.state",
            "title": "State"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/interstate_flows_2024_25.csv",
        "format": {
          "parse": {
            "visits": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "147.6",
          "as": "dlon"
        },
        {
          "calculate": "-32.3",
          "as": "dlat"
        },
        {
          "calculate": "(datum.lon + datum.dlon) / 2 - 0.2 * (datum.dlat - datum.lat)",
          "as": "cx"
        },
        {
          "calculate": "(datum.lat + datum.dlat) / 2 + 0.2 * (datum.dlon - datum.lon)",
          "as": "cy"
        },
        {
          "calculate": "datum.origin + ' ' + (datum.visits >= 1e6 ? format(datum.visits / 1e6, '.1f') + 'M' : format(datum.visits / 1e3, '.0f') + 'k')",
          "as": "label"
        }
      ],
      "layer": [
        {
          "transform": [
            {
              "calculate": "sequence(0, 25)",
              "as": "i"
            },
            {
              "flatten": [
                "i"
              ]
            },
            {
              "calculate": "datum.i / 24",
              "as": "t"
            },
            {
              "calculate": "pow(1 - datum.t, 2) * datum.lon + 2 * (1 - datum.t) * datum.t * datum.cx + pow(datum.t, 2) * datum.dlon",
              "as": "px"
            },
            {
              "calculate": "pow(1 - datum.t, 2) * datum.lat + 2 * (1 - datum.t) * datum.t * datum.cy + pow(datum.t, 2) * datum.dlat",
              "as": "py"
            }
          ],
          "mark": {
            "type": "line",
            "color": "#e76f51",
            "opacity": 0.6,
            "strokeCap": "round",
            "strokeJoin": "round"
          },
          "encoding": {
            "longitude": {
              "field": "px",
              "type": "quantitative"
            },
            "latitude": {
              "field": "py",
              "type": "quantitative"
            },
            "order": {
              "field": "t",
              "type": "quantitative"
            },
            "detail": {
              "field": "origin",
              "type": "nominal"
            },
            "size": {
              "field": "visits",
              "type": "quantitative",
              "scale": {
                "type": "sqrt",
                "range": [
                  1,
                  6
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "origin",
                "title": "From"
              },
              {
                "field": "visits",
                "title": "Visits to NSW parks",
                "format": ","
              }
            ]
          }
        },
        {
          "transform": [
            {
              "calculate": "0.2025 * datum.lon + 0.4950 * datum.cx + 0.3025 * datum.dlon",
              "as": "hx"
            },
            {
              "calculate": "0.2025 * datum.lat + 0.4950 * datum.cy + 0.3025 * datum.dlat",
              "as": "hy"
            },
            {
              "calculate": "0.9000 * (datum.cx - datum.lon) + 1.1000 * (datum.dlon - datum.cx)",
              "as": "tx"
            },
            {
              "calculate": "0.9000 * (datum.cy - datum.lat) + 1.1000 * (datum.dlat - datum.cy)",
              "as": "ty"
            },
            {
              "calculate": "atan2(datum.tx * cos(datum.hy * PI / 180), datum.ty) * 180 / PI + 0.4486 * (datum.hx - 132)",
              "as": "heading"
            }
          ],
          "mark": {
            "type": "point",
            "shape": "triangle-up",
            "filled": true,
            "color": "#e76f51",
            "opacity": 0.95
          },
          "encoding": {
            "longitude": {
              "field": "hx",
              "type": "quantitative"
            },
            "latitude": {
              "field": "hy",
              "type": "quantitative"
            },
            "angle": {
              "field": "heading",
              "type": "quantitative",
              "scale": null
            },
            "size": {
              "field": "visits",
              "type": "quantitative",
              "scale": {
                "type": "sqrt",
                "range": [
                  25,
                  130
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "origin",
                "title": "From"
              },
              {
                "field": "visits",
                "title": "Visits to NSW parks",
                "format": ","
              }
            ]
          }
        },
        {
          "mark": {
            "type": "circle",
            "color": "#8a3b24",
            "opacity": 0.9,
            "stroke": "white",
            "strokeWidth": 1
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "size": {
              "field": "visits",
              "type": "quantitative",
              "scale": {
                "range": [
                  20,
                  300
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "origin",
                "title": "From"
              },
              {
                "field": "visits",
                "title": "Visits to NSW parks",
                "format": ","
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.label_pos == 'east'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 10,
            "dy": 0,
            "baseline": "middle",
            "fontSize": 11,
            "color": "#2b2b2b"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.label_pos == 'west'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -10,
            "dy": 0,
            "baseline": "middle",
            "fontSize": 11,
            "color": "#2b2b2b"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.label_pos == 'north'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "center",
            "dx": 0,
            "dy": -14,
            "baseline": "middle",
            "fontSize": 11,
            "color": "#2b2b2b"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.label_pos == 'south'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "center",
            "dx": 0,
            "dy": 14,
            "baseline": "middle",
            "fontSize": 11,
            "color": "#2b2b2b"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        }
      ],
      "resolve": {
        "scale": {
          "size": "independent"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 147.6,
            "lat": -32.3,
            "t": "NSW national parks"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "size": 160,
            "color": "#1f3d17"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 10,
            "dy": -10,
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#1f3d17"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}