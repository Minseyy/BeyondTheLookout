{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Most interstate visitors come from next door",
    "subtitle": [
      "Visits to NSW national parks by people from other states, 2024/25.",
      "Thicker line = more visits. Hover a city, region or line to highlight it."
    ],
    "anchor": "start",
    "subtitleFontSize": 12,
    "subtitleColor": "#6b6b6b"
  },
  "autosize": { "type": "fit", "contains": "padding" },
  "vconcat": [
    {
      "width": "container",
      "height": 124,
      "layer": [
        {
          "data": {
            "values": [
              { "t": "Where from", "x": 4, "y": 8 },
              { "t": "Visits per curve", "x": 4, "y": 84 }
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#2b2b2b"
          },
          "encoding": {
            "x": { "field": "x", "type": "quantitative", "scale": null, "axis": null },
            "y": { "field": "y", "type": "quantitative", "scale": null, "axis": null },
            "text": { "field": "t" }
          }
        },
        {
          "data": {
            "url": "data/5.1_interstate_flow_map/interstate_flows_2024_25.csv",
            "format": { "parse": { "visits": "number" } }
          },
          "transform": [
            {
              "calculate": "indexof(['QLD', 'VIC', 'ACT'], datum.state) >= 0 ? 'Next door' : 'Further away'",
              "as": "group"
            },
            {
              "aggregate": [{ "op": "sum", "field": "visits", "as": "groupVisits" }],
              "groupby": ["group"]
            },
            {
              "joinaggregate": [{ "op": "sum", "field": "groupVisits", "as": "total" }]
            },
            {
              "calculate": "datum.group == 'Next door' ? 'Next door: QLD, VIC, ACT (' + format(datum.groupVisits / datum.total, '.0%') + ')' : 'Further away: SA, NT, TAS, WA (' + format(datum.groupVisits / datum.total, '.0%') + ')'",
              "as": "label"
            },
            { "calculate": "datum.group == 'Next door' ? 30 : 52", "as": "y" },
            { "calculate": "datum.group == 'Next door' ? '#e76f51' : '#c2b4a3'", "as": "c" },
            { "calculate": "4", "as": "x0" },
            { "calculate": "44", "as": "x1" }
          ],
          "encoding": {
            "x": { "field": "x0", "type": "quantitative", "scale": null, "axis": null },
            "y": { "field": "y", "type": "quantitative", "scale": null, "axis": null }
          },
          "layer": [
            {
              "mark": { "type": "rule", "strokeWidth": 5, "strokeCap": "round" },
              "encoding": {
                "x2": { "field": "x1" },
                "color": { "field": "c", "type": "nominal", "scale": null }
              }
            },
            {
              "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "dx": 50,
                "fontSize": 11,
                "color": "#2b2b2b"
              },
              "encoding": { "text": { "field": "label" } }
            }
          ]
        },
        {
          "data": {
            "values": [
              { "x0": 4, "x1": 34, "y": 106, "v": 500000, "label": "0.5 million" },
              { "x0": 134, "x1": 164, "y": 106, "v": 1000000, "label": "1 million" },
              { "x0": 254, "x1": 284, "y": 106, "v": 2000000, "label": "2 million" }
            ]
          },
          "encoding": {
            "x": { "field": "x0", "type": "quantitative", "scale": null, "axis": null },
            "y": { "field": "y", "type": "quantitative", "scale": null, "axis": null }
          },
          "layer": [
            {
              "mark": { "type": "rule", "color": "#e76f51", "strokeCap": "round" },
              "encoding": {
                "x2": { "field": "x1" },
                "size": {
                  "field": "v",
                  "type": "quantitative",
                  "scale": { "type": "sqrt", "domain": [0, 2200000], "range": [1, 9] },
                  "legend": null
                }
              }
            },
            {
              "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "dx": 36,
                "fontSize": 11,
                "color": "#2b2b2b"
              },
              "encoding": { "text": { "field": "label" } }
            }
          ]
        }
      ]
    },
    {
      "width": "container",
      "height": 560,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [-18, -36],
        "rotate": [-132, 0]
      },
      "params": [
        {
          "name": "hoverOrigin",
          "select": {
            "type": "point",
            "fields": ["origin"],
            "on": "mouseover",
            "clear": "mouseout"
          },
          "views": ["flow_dots"]
        }
      ],
      "layer": [
        {
          "data": {
            "url": "data/5.1_interstate_flow_map/australia_states.json",
            "format": { "type": "json", "property": "features" }
          },
          "mark": { "type": "geoshape", "stroke": "#cfc9ba", "strokeWidth": 1 },
          "encoding": {
            "color": {
              "condition": { "test": "datum.properties.is_nsw", "value": "#bfdcae" },
              "value": "#ebe6da"
            },
            "tooltip": [{ "field": "properties.state", "title": "State" }]
          }
        },
        {
          "data": {
            "url": "data/5.1_interstate_flow_map/interstate_flows_2024_25.csv",
            "format": { "parse": { "visits": "number", "lon": "number", "lat": "number" } }
          },
          "transform": [
            { "calculate": "147.6", "as": "dlon" },
            { "calculate": "-32.3", "as": "dlat" },
            {
              "calculate": "(datum.lon + datum.dlon) / 2 - 0.2 * (datum.dlat - datum.lat)",
              "as": "cx"
            },
            {
              "calculate": "(datum.lat + datum.dlat) / 2 + 0.2 * (datum.dlon - datum.lon)",
              "as": "cy"
            },
            {
              "calculate": "min(0.97, max(0.5, 1 - 0.9 / sqrt(pow(datum.dlon - datum.lon, 2) + pow(datum.dlat - datum.lat, 2))))",
              "as": "te"
            },
            {
              "calculate": "datum.origin == 'Melbourne' ? 'west' : datum.label_pos",
              "as": "label_pos"
            },
            { "joinaggregate": [{ "op": "sum", "field": "visits", "as": "total" }] },
            { "calculate": "datum.visits / datum.total", "as": "share" },
            {
              "calculate": "indexof(['QLD', 'VIC', 'ACT'], datum.state) >= 0 ? 'Next door' : 'Further away'",
              "as": "group"
            },
            {
              "calculate": "datum.origin + '\\n' + (datum.visits >= 1e6 ? format(datum.visits / 1e6, '.1f') + 'M' : format(datum.visits / 1e3, '.0f') + 'K')",
              "as": "label"
            }
          ],
          "layer": [
            {
              "transform": [
                { "calculate": "sequence(0, 23)", "as": "i" },
                { "flatten": ["i"] },
                { "calculate": "datum.i / 22 * datum.te", "as": "t" },
                {
                  "calculate": "pow(1 - datum.t, 2) * datum.lon + 2 * (1 - datum.t) * datum.t * datum.cx + pow(datum.t, 2) * datum.dlon",
                  "as": "px"
                },
                {
                  "calculate": "pow(1 - datum.t, 2) * datum.lat + 2 * (1 - datum.t) * datum.t * datum.cy + pow(datum.t, 2) * datum.dlat",
                  "as": "py"
                }
              ],
              "mark": { "type": "line", "strokeCap": "round", "strokeJoin": "round" },
              "encoding": {
                "longitude": { "field": "px", "type": "quantitative" },
                "latitude": { "field": "py", "type": "quantitative" },
                "order": { "field": "t", "type": "quantitative" },
                "detail": { "field": "origin", "type": "nominal" },
                "size": {
                  "field": "visits",
                  "type": "quantitative",
                  "scale": { "type": "sqrt", "domain": [0, 2200000], "range": [1, 9] },
                  "legend": null
                },
                "opacity": {
                  "condition": { "param": "hoverOrigin", "empty": true, "value": 0.8 },
                  "value": 0.15
                },
                "tooltip": [
                  { "field": "origin", "title": "From" },
                  { "field": "state", "title": "State" },
                  { "field": "visits", "title": "Visits to NSW parks", "format": "," },
                  { "field": "share", "title": "Share of interstate visits", "format": ".1%" }
                ],
                "color": {
                  "condition": {
                    "test": "indexof(['QLD', 'VIC', 'ACT'], datum.state) >= 0",
                    "value": "#e76f51"
                  },
                  "value": "#c2b4a3"
                }
              }
            },
            {
              "name": "flow_hit",
              "transform": [
                { "calculate": "sequence(0, 23)", "as": "i" },
                { "flatten": ["i"] },
                { "calculate": "datum.i / 22 * datum.te", "as": "t" },
                {
                  "calculate": "pow(1 - datum.t, 2) * datum.lon + 2 * (1 - datum.t) * datum.t * datum.cx + pow(datum.t, 2) * datum.dlon",
                  "as": "px"
                },
                {
                  "calculate": "pow(1 - datum.t, 2) * datum.lat + 2 * (1 - datum.t) * datum.t * datum.cy + pow(datum.t, 2) * datum.dlat",
                  "as": "py"
                }
              ],
              "mark": {
                "type": "line",
                "strokeWidth": 16,
                "strokeCap": "round",
                "strokeJoin": "round",
                "opacity": 0.01,
                "cursor": "pointer"
              },
              "encoding": {
                "longitude": { "field": "px", "type": "quantitative" },
                "latitude": { "field": "py", "type": "quantitative" },
                "order": { "field": "t", "type": "quantitative" },
                "detail": { "field": "origin", "type": "nominal" },
                "color": { "value": "#000000" },
                "tooltip": [
                  { "field": "origin", "title": "From" },
                  { "field": "state", "title": "State" },
                  { "field": "visits", "title": "Visits to NSW parks", "format": "," },
                  { "field": "share", "title": "Share of interstate visits", "format": ".1%" }
                ]
              }
            },
            {
              "name": "flow_heads",
              "transform": [
                {
                  "calculate": "pow(1 - datum.te, 2) * datum.lon + 2 * (1 - datum.te) * datum.te * datum.cx + pow(datum.te, 2) * datum.dlon",
                  "as": "hx"
                },
                {
                  "calculate": "pow(1 - datum.te, 2) * datum.lat + 2 * (1 - datum.te) * datum.te * datum.cy + pow(datum.te, 2) * datum.dlat",
                  "as": "hy"
                },
                {
                  "calculate": "2 * (1 - datum.te) * (datum.cx - datum.lon) + 2 * datum.te * (datum.dlon - datum.cx)",
                  "as": "tx"
                },
                {
                  "calculate": "0.2400 * (datum.cy - datum.lat) + 1.7600 * (datum.dlat - datum.cy)",
                  "as": "ty"
                },
                {
                  "calculate": "atan2(datum.tx * cos(datum.hy * PI / 180), datum.ty) * 180 / PI + 0.4486 * (datum.hx - 132)",
                  "as": "heading"
                }
              ],
              "mark": { "type": "point", "shape": "triangle-up", "filled": true },
              "encoding": {
                "longitude": { "field": "hx", "type": "quantitative" },
                "latitude": { "field": "hy", "type": "quantitative" },
                "angle": { "field": "heading", "type": "quantitative", "scale": null },
                "size": {
                  "field": "visits",
                  "type": "quantitative",
                  "scale": { "type": "sqrt", "domain": [0, 2200000], "range": [30, 170] },
                  "legend": null
                },
                "opacity": {
                  "condition": { "param": "hoverOrigin", "empty": true, "value": 0.95 },
                  "value": 0.15
                },
                "tooltip": [
                  { "field": "origin", "title": "From" },
                  { "field": "state", "title": "State" },
                  { "field": "visits", "title": "Visits to NSW parks", "format": "," },
                  { "field": "share", "title": "Share of interstate visits", "format": ".1%" }
                ],
                "color": {
                  "condition": {
                    "test": "indexof(['QLD', 'VIC', 'ACT'], datum.state) >= 0",
                    "value": "#e76f51"
                  },
                  "value": "#c2b4a3"
                }
              }
            },
            {
              "name": "flow_dots",
              "mark": { "type": "circle", "stroke": "white", "strokeWidth": 1, "cursor": "pointer" },
              "encoding": {
                "longitude": { "field": "lon", "type": "quantitative" },
                "latitude": { "field": "lat", "type": "quantitative" },
                "size": {
                  "field": "visits",
                  "type": "quantitative",
                  "scale": { "domain": [0, 2200000], "range": [40, 420] },
                  "legend": null
                },
                "opacity": {
                  "condition": { "param": "hoverOrigin", "empty": true, "value": 0.95 },
                  "value": 0.3
                },
                "tooltip": [
                  { "field": "origin", "title": "From" },
                  { "field": "state", "title": "State" },
                  { "field": "visits", "title": "Visits to NSW parks", "format": "," },
                  { "field": "share", "title": "Share of interstate visits", "format": ".1%" }
                ],
                "color": {
                  "condition": {
                    "test": "indexof(['QLD', 'VIC', 'ACT'], datum.state) >= 0",
                    "value": "#8a3b24"
                  },
                  "value": "#9c8d7c"
                }
              }
            },
            {
              "transform": [{ "filter": "datum.label_pos == 'east'" }],
              "mark": {
                "type": "text",
                "align": "left",
                "dx": 14,
                "dy": 0,
                "baseline": "middle",
                "fontSize": 11,
                "lineHeight": 13,
                "lineBreak": "\n",
                "fontWeight": 500
              },
              "encoding": {
                "longitude": { "field": "lon", "type": "quantitative" },
                "latitude": { "field": "lat", "type": "quantitative" },
                "text": { "field": "label" },
                "opacity": {
                  "condition": { "param": "hoverOrigin", "empty": true, "value": 0.8 },
                  "value": 0.15
                },
                "color": {
                  "condition": {
                    "test": "indexof(['QLD', 'VIC', 'ACT'], datum.state) >= 0",
                    "value": "#2b2b2b"
                  },
                  "value": "#6f665a"
                },
                "size": {
                  "condition": {
                    "test": "indexof(['QLD', 'VIC', 'ACT'], datum.state) >= 0",
                    "value": 11.5
                  },
                  "value": 10
                }
              }
            },
            {
              "transform": [{ "filter": "datum.label_pos == 'west'" }],
              "mark": {
                "type": "text",
                "align": "right",
                "dx": -14,
                "dy": 0,
                "baseline": "middle",
                "fontSize": 11,
                "lineHeight": 13,
                "lineBreak": "\n",
                "fontWeight": 500
              },
              "encoding": {
                "longitude": { "field": "lon", "type": "quantitative" },
                "latitude": { "field": "lat", "type": "quantitative" },
                "text": { "field": "label" },
                "opacity": {
                  "condition": { "param": "hoverOrigin", "empty": true, "value": 0.8 },
                  "value": 0.15
                },
                "color": {
                  "condition": {
                    "test": "indexof(['QLD', 'VIC', 'ACT'], datum.state) >= 0",
                    "value": "#2b2b2b"
                  },
                  "value": "#6f665a"
                },
                "size": {
                  "condition": {
                    "test": "indexof(['QLD', 'VIC', 'ACT'], datum.state) >= 0",
                    "value": 11.5
                  },
                  "value": 10
                }
              }
            },
            {
              "transform": [{ "filter": "datum.label_pos == 'north'" }],
              "mark": {
                "type": "text",
                "align": "center",
                "dx": 0,
                "dy": -28,
                "baseline": "middle",
                "fontSize": 11,
                "lineHeight": 13,
                "lineBreak": "\n",
                "fontWeight": 500
              },
              "encoding": {
                "longitude": { "field": "lon", "type": "quantitative" },
                "latitude": { "field": "lat", "type": "quantitative" },
                "text": { "field": "label" },
                "opacity": {
                  "condition": { "param": "hoverOrigin", "empty": true, "value": 0.8 },
                  "value": 0.15
                },
                "color": {
                  "condition": {
                    "test": "indexof(['QLD', 'VIC', 'ACT'], datum.state) >= 0",
                    "value": "#2b2b2b"
                  },
                  "value": "#6f665a"
                },
                "size": {
                  "condition": {
                    "test": "indexof(['QLD', 'VIC', 'ACT'], datum.state) >= 0",
                    "value": 11.5
                  },
                  "value": 10
                }
              }
            },
            {
              "transform": [{ "filter": "datum.label_pos == 'south'" }],
              "mark": {
                "type": "text",
                "align": "center",
                "dx": 0,
                "dy": 28,
                "baseline": "middle",
                "fontSize": 11,
                "lineHeight": 13,
                "lineBreak": "\n",
                "fontWeight": 500
              },
              "encoding": {
                "longitude": { "field": "lon", "type": "quantitative" },
                "latitude": { "field": "lat", "type": "quantitative" },
                "text": { "field": "label" },
                "opacity": {
                  "condition": { "param": "hoverOrigin", "empty": true, "value": 0.8 },
                  "value": 0.15
                },
                "color": {
                  "condition": {
                    "test": "indexof(['QLD', 'VIC', 'ACT'], datum.state) >= 0",
                    "value": "#2b2b2b"
                  },
                  "value": "#6f665a"
                },
                "size": {
                  "condition": {
                    "test": "indexof(['QLD', 'VIC', 'ACT'], datum.state) >= 0",
                    "value": 11.5
                  },
                  "value": 10
                }
              }
            }
          ],
          "resolve": { "scale": { "size": "independent" } }
        },
        {
          "data": {
            "values": [{ "lon": 147.6, "lat": -32.3, "t": "NSW national parks" }]
          },
          "layer": [
            {
              "mark": {
                "type": "circle",
                "size": 450,
                "color": "#1f3d17",
                "stroke": "white",
                "strokeWidth": 1.5
              },
              "encoding": {
                "longitude": { "field": "lon", "type": "quantitative" },
                "latitude": { "field": "lat", "type": "quantitative" }
              }
            },
            {
              "mark": {
                "type": "text",
                "align": "left",
                "dx": 18,
                "dy": -14,
                "fontSize": 12.5,
                "fontWeight": "bold",
                "color": "#1f3d17"
              },
              "encoding": {
                "longitude": { "field": "lon", "type": "quantitative" },
                "latitude": { "field": "lat", "type": "quantitative" },
                "text": { "field": "t" }
              }
            }
          ]
        }
      ]
    }
  ],
  "resolve": { "scale": { "x": "independent", "y": "independent", "size": "independent" } }
}