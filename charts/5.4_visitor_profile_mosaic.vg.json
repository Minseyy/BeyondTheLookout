{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Locals come for the park. Interstate visitors come for the trip",
    "subtitle": [
      "Left: NSW visitors (84% of visits). Right: interstate visitors (16%)."
    ]
  },
  "width": "container",
  "height": 300,
  "params": [
    {
      "name": "question",
      "value": "Why they came",
      "bind": {
        "input": "radio",
        "options": [
          "Why they came",
          "How long they stayed",
          "How satisfied they were"
        ],
        "name": "Show: "
      }
    }
  ],
  "data": {
    "url": "data/_shared/visitor_profile_2024_25.csv",
    "format": {
      "parse": {
        "order": "number",
        "pct": "number",
        "origin_visits": "number",
        "x0": "number",
        "x1": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.question == question"
    },
    {
      "stack": "pct",
      "groupby": ["origin"],
      "sort": [
        {
          "field": "order",
          "order": "ascending"
        }
      ],
      "offset": "normalize",
      "as": ["y0", "y1"]
    },
    {
      "calculate": "(datum.y0 + datum.y1) / 2",
      "as": "ymid"
    },
    {
      "calculate": "(datum.x0 + datum.x1) / 2",
      "as": "xmid"
    },
    {
      "calculate": "format(datum.origin_visits * datum.pct / 100 / 1e6, '.1f') + ' million visits'",
      "as": "visits_text"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#f7f2e4",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          },
          "axis": null
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1],
            "reverse": true
          },
          "axis": null
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "answer",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Main reason for the trip",
              "Part of the reason",
              "Not a reason / can't say",
              "Day trip",
              "Stayed one night or more",
              "Can't say",
              "Satisfied",
              "Neutral or dissatisfied"
            ],
            "range": [
              "#b5462b",
              "#f4a261",
              "#e4ddd0",
              "#2f5e22",
              "#8fb98a",
              "#e4ddd0",
              "#2a6f97",
              "#e4ddd0"
            ]
          }
        },
        "tooltip": [
          {
            "field": "origin",
            "title": "Visitors"
          },
          {
            "field": "answer",
            "title": "Answer"
          },
          {
            "field": "pct",
            "title": "% of this group"
          },
          {
            "field": "visits_text",
            "title": "About"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.y1 - datum.y0 >= 0.06"
        },
        {
          "calculate": "datum.origin == 'NSW visitors' ? datum.answer + '  ' + datum.pct + '%' : datum.pct + '%'",
          "as": "inside"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "xmid",
          "type": "quantitative"
        },
        "y": {
          "field": "ymid",
          "type": "quantitative"
        },
        "text": {
          "field": "inside"
        },
        "color": {
          "field": "text_colour",
          "type": "nominal",
          "scale": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.origin == 'Interstate visitors'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 11,
        "color": "#2b2b2b"
      },
      "encoding": {
        "x": {
          "datum": 1,
          "type": "quantitative"
        },
        "y": {
          "field": "ymid",
          "type": "quantitative"
        },
        "text": {
          "field": "answer"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.order == 0"
        },
        {
          "calculate": "datum.origin == 'NSW visitors' ? 'NSW visitors · 84% of visits' : 'Interstate · 16%'",
          "as": "header"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "bottom",
        "dy": -8,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#1f3d17"
      },
      "encoding": {
        "x": {
          "field": "xmid",
          "type": "quantitative"
        },
        "y": {
          "datum": 0,
          "type": "quantitative"
        },
        "text": {
          "field": "header"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
