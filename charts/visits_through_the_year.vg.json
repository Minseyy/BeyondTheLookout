{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Visits through the year",
  "width": "container",
  "height": 260,
  "data": {
    "url": "data/monthly_index_2024_25_CHECK.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          4
        ]
      },
      "encoding": {
        "y": {
          "datum": 100
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "point": true
      },
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": null,
          "title": null,
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "visit_index",
          "type": "quantitative",
          "title": "Visit index (100 = average month)",
          "scale": {
            "zero": false
          }
        },
        "tooltip": [
          {
            "field": "month",
            "title": "Month"
          },
          {
            "field": "visit_index",
            "title": "Index"
          }
        ]
      }
    }
  ]
}
